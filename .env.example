# Servidor
PORT=3000
NODE_ENV=development


# JWT (gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=GERE_UM_SEGREDO_FORTE_AQUI
JWT_EXPIRES_IN=24h


# URL do front-end (usada nos links de e-mail)
APP_URL=http://localhost:4200


# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=SUA_SENHA_CRIADA_NA_INSTALACAO
DB_NAME=bnotasweb


# CORS (separar por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200


# --- CONFIGURAÇÃO DE EMAIL ---
# Use uma "senha de app" do Gmail (https://myaccount.google.com/apppasswords)
# NUNCA coloque a senha real aqui nem faça commit deste valor preenchido
EMAIL_USER=
EMAIL_PASS=


# --- ENCRYPTION (32 bytes em hex = 64 caracteres) ---
ENCRYPTION_KEY=


# --- MERCADO PAGO ---
# Desenvolvimento: Access Token de TESTE (TEST-...). Producao: APP_USR-...
MP_ACCESS_TOKEN=
# URL publica da API para o webhook (producao ou ngrok em dev). Opcional.
MP_WEBHOOK_URL=
